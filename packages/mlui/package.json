{
  "name": "@teawithsand/mlui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
	"types": "dist/index.d.ts",
  "scripts": {
    "format:fix": "prettier ./src --write",
    "format:check": "prettier ./src --check",
    "format:check:cached": "prettier ./src --check --cache",
    "lint:fix": "eslint ./src --fix",
    "test:mutate": "stryker run",
    "test": "vitest",
    "test:ss": "vitest -u",
    "build:check": "tsc --noEmit --project tsconfig.lib.json",
    "fix": "npm run format:fix && npm run lint:fix",
    "pre-commit-check": "npm run build:check && npm run lint:cached && npm run format:check:cached",
    "pre-push-check": "npm run build:check && npm run lint:cached && npm run format:check:cached && npm run test",
    "prepublishOnly": "npm run build && npm run lint && npm run format:check && npm run test",
    "dev": "vite -c vite.preview.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint ./src --max-warnings 0",
    "lint:cached": "eslint ./src --max-warnings 0 --cache",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-router": "~7.6.3",
    "@tabler/icons-react": "~3.34.0"
  },
  "devDependencies": {
    "react": "^19.1.0",
    "react-router": "~7.6.3",
    "@tabler/icons-react": "~3.34.0",
    "@eslint/js": "^9.25.0",
    "@types/react": "^19.1.0",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "eslint": "^9.26.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.32.0",
    "vite": "^6.3.5",
    "vite-plugin-dts": "~4.5.4",
    "@typescript-eslint/parser": "^8.32.0",
    "@vitest/coverage-istanbul": "~3.2.4",
    "eslint-plugin-unused-imports": "^4.1.4",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "vitest": "3.2.4",
    "@stryker-mutator/vitest-runner": "~9.0.1",
    "sass-embedded": "~1.89.1",
    "rimraf": "~6.0.1",
    "@testing-library/react": "~16.3.0",
    "@testing-library/user-event": "~14.6.1",
    "@testing-library/jest-dom": "~6.6.3",
    "@testing-library/dom": "~10.4.0",
    "eslint-config-mantine": "~4.0.3",
    "react-dom": "19.1.0",
    "@types/react-dom": "~19.1.6"
  },
  "files": [
		"dist",
		"LICENSE",
		"README.md"
	],
  "dependencies": {
    "@teawithsand/fstate": "workspace:*",
    "@teawithsand/lngext": "workspace:*",
    "@teawithsand/llog": "workspace:*",
    "@mantine/core": "~8.2.7",
    "@mantine/hooks": "~8.2.7",
    "@mantine/notifications": "~8.2.7"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
