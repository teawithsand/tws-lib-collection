{
  "name": "@teawithsand/rts-engine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "format:fix": "cargo fmt",
    "format:check": "cargo fmt --check",
    "format:check:cached": "cargo fmt --check",
    "lint:fix": "cargo fix",
    "test": "cargo test",
    "test:browser": "wasm-pack test --headless --firefox",
    "build:check": "cargo check",
    "fix": "cargo fix --allow-dirty && cargo fmt",
    "pre-commit-check": "cargo fmt --check && cargo check",
    "pre-push-check": "cargo check && cargo fmt --check && cargo test",
    "prepublishOnly": "cargo check && cargo fmt --check && cargo test",
    "build": "rimraf ./dist && rimraf ./pkg && wasm-pack build --target bundler --out-dir ./pkg --out-name index && node build.js"
  },
  "devDependencies": {
    "rimraf": "~6.1.2"
  },
  "files": [
    "dist"
  ]
}
